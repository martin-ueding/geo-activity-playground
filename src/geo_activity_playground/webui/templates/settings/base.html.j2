{% extends "page.html.j2" %}
{% from "nav-macros.html.j2" import nav_active with context %}

{# Navigation structure for settings pages #}
{% set settings_nav = [
    {
        "group": _("Data Sources"),
        "entries": [
            {"endpoint": "settings.strava", "label": _("Strava API"), "icon": "🔗"},
            {"endpoint": "settings.hammerhead", "label": _("Hammerhead API"), "icon": "🚴"},
            {"endpoint": "settings.garmin", "label": _("Garmin API"), "icon": "⌚"},
            {"endpoint": "settings.metadata_extraction", "label": _("Metadata Extraction"), "icon": "📝"},
            {"endpoint": "settings.excluded_activities", "label": _("Excluded Activities"), "icon": "🚫"},
            {"endpoint": "settings.duplicate_matching", "label": _("Duplicate Matching"), "icon": "🧬"},
            {"endpoint": "settings.possible_duplicates", "label": _("Possible Duplicates"), "icon": "👥"},
        ]
    },
    {
        "group": _("Display"),
        "entries": [
            {"endpoint": "settings.color_schemes", "label": _("Color Schemes"), "icon": "🎨"},
            {"endpoint": "settings.tile_source", "label": _("Map Tile Source"), "icon": "🧭"},
            {"endpoint": "settings.language", "label": _("Language"), "icon": "🌐"},
            {"endpoint": "settings.currency", "label": _("Currency"), "icon": "💶"},
            {"endpoint": "settings.table_columns", "label": _("Table Columns"), "icon": "📊"},
            {"endpoint": "settings.map_display", "label": _("Map Display"), "icon": "🗾"},
        ]
    },
    {
        "group": _("Explorer Tiles"),
        "entries": [
            {"endpoint": "settings.explorer_zoom_levels", "label": _("Explorer Levels"), "icon": "🔍"},
            {"endpoint": "settings.explorer_counted_activities", "label": _("Counted Activities"), "icon": "🎯"},
            {"endpoint": "settings.explorer_tiles", "label": _("Inaccessible Tiles"), "icon": "🧩"},
            {"endpoint": "settings.tile_rendering", "label": _("Tile Coloring"), "icon": "🗺️"},
        ]
    },
    {
        "group": _("Analysis"),
        "entries": [
            {"endpoint": "settings.segmentation", "label": _("Track Segmentation"), "icon": "✂️"},
            {"endpoint": "plot_builder.index", "label": _("Plot Builder"), "icon": "📊",
             "match": ["plot_builder."]},
        ]
    },
    {
        "group": _("Personal"),
        "entries": [
            {"endpoint": "settings.heart_rate", "label": _("Heart Rate"), "icon": "❤️"},
        ]
    },
    {
        "group": _("Management"),
        "entries": [
            {"endpoint": "settings.manage_kinds", "label": _("Activity Kinds"), "icon": "🏃",
             "match": ["settings.kinds_new", "settings.kinds_edit", "settings.kinds_delete"]},
            {"endpoint": "settings.tags_list", "label": _("Tags"), "icon": "🏷️",
             "match": ["settings.tags_new", "settings.tags_edit"]},
        ]
    },
    {
        "group": _("Privacy & Security"),
        "entries": [
            {"endpoint": "settings.privacy_zones", "label": _("Privacy Zones"), "icon": "🔒",
             "match": ["settings.privacy_zones_new", "settings.privacy_zones_edit", "settings.privacy_zones_delete"]},
            {"endpoint": "settings.sharepic", "label": _("Share Picture"), "icon": "📷"},
            {"endpoint": "authentication.change_password", "label": _("Admin Password"), "icon": "🔑"},
        ]
    },
    {
        "group": _("System"),
        "entries": [
            {"endpoint": "settings.maintenance", "label": _("Technical Maintenance"), "icon": "🛠️"},
            {"endpoint": "settings.heatmap_cache", "label": _("Heatmap Cache"), "icon": "🔥"},
        ]
    },
] %}

{% block container %}
<div class="row">
    {# Breadcrumbs #}
    <div class="col-12 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ url_for('settings.index') }}">{{ _('Settings') }}</a></li>
                {% block breadcrumbs %}{% endblock %}
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    {# Sidebar Navigation #}
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="d-md-none mb-3">
            <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" 
                    data-bs-target="#settingsNav" aria-expanded="false" aria-controls="settingsNav">
                ☰ {{ _('Settings Menu') }}
            </button>
        </div>
        
        <nav id="settingsNav" class="collapse d-md-block bg-body-tertiary rounded p-3">
            {% for group in settings_nav %}
            <h6 class="text-body-secondary text-uppercase small fw-bold mb-2 {% if not loop.first %}mt-3{% endif %}">
                {{ group.group }}
            </h6>
            <ul class="nav nav-pills flex-column mb-2">
                {% for item in group.entries %}
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 {{ nav_active(item) | trim }}"
                       href="{{ url_for(item.endpoint) }}"
                       {% if nav_active(item) | trim %}aria-current="page"{% endif %}>
                        <span class="me-2">{{ item.icon }}</span>{{ item.label }}
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% endfor %}
        </nav>
    </div>
    
    {# Main Content Area #}
    <div class="col-lg-9 col-md-8">
        {% block settings_content %}{% endblock %}
    </div>
</div>
{% endblock %}
