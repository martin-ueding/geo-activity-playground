{% macro vega(path) %}
{% set id = unique_id() %}
<div id="{{ id }}"></div>
<script type="text/javascript">
    vegaEmbed('#{{ id }}', "{{ path }}").then(function (result) { }).catch(console.error);
</script>
{% endmacro %}

{% macro vega_direct(spec) %}
{% set id = unique_id() %}
<div id="{{ id }}"></div>
<script type="text/javascript">
    vegaEmbed('#{{ id }}', {{ spec| safe }}).then(function (result) { }).catch(console.error);
</script>
{% endmacro %}

{# Defines window.add_map(element_id, geojson, options). Include once per page that shows maps.
   `geojson` may be null to get a bare map without a layer. Options: weight, opacity, padding. #}
{% macro map_script() %}
<script type="module">
    import { add_layers_to_map } from '/static/map-layers.js';

    window.add_map = function (element_id, geojson, options = {}) {
        let map = L.map(element_id, {
            fullscreenControl: true
        })
        add_layers_to_map(map, {
            zoom: {{ explorer_zoom_levels[0] }},
            zoomLevels: {{ explorer_zoom_levels | tojson }},
            attribution: '{{ map_tile_attribution|safe }}',
            baseLayer: 'Color',
            overlay: null
        })

        if (!geojson) {
            return map
        }

        let geojson_layer = L.geoJSON(geojson, {
            style: feature => {
                if (feature?.geometry?.type === "LineString") {
                    return {
                        color: feature?.properties?.color || "#3388ff",
                        weight: options.weight || 4,
                        opacity: options.opacity || 1
                    };
                }
                return {};
            },
            pointToLayer: (feature, latlng) => {
                const progress = feature?.properties?.marker_progress;
                if (Number.isFinite(progress)) {
                    return L.marker(latlng, {
                        icon: window.progressMarkerIcon(progress, feature?.properties?.marker_is_eighth)
                    });
                }
                return L.circleMarker(latlng);
            }
        }).addTo(map)
        if (geojson_layer.getLayers().length > 0) {
            map.fitBounds(geojson_layer.getBounds(), { padding: options.padding || [10, 10] })
        }
        return map
    }
</script>
{% endmacro %}

{# A map container that loads its geometry from `url`. Requires map_script() on the page.
   The module type makes this run after map_script() has defined `add_map`. #}
{% macro fetched_map(element_id, url, height='200px', classes='card-img-top') %}
<div class="{{ classes }}" id="{{ element_id }}" style="height: {{ height }}; width: 100%;"></div>
<script type="module">
    fetch("{{ url }}").then(response => response.json()).then(
        geojson => { add_map("{{ element_id }}", geojson) }
    )
</script>
{% endmacro %}

{% macro activity_tag(tag) %}
<span class="badge" style="background-color: {{ tag.color or '#0d6efd' }}">{{ tag.tag }}</span>
{% endmacro %}

{% macro tabbed_vega(tab_dict, last=False) %}
{% set id = unique_id() %}
<ul class="nav nav-pills mb-3" role="tablist">
    {% for key in tab_dict.keys() %}
    {% set plot_id = id ~ "-" ~ loop.index %}
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if (last and loop.last) or (not last and loop.first) %} active {% endif %}"
            id="{{ plot_id }}-tab" data-bs-toggle="tab" data-bs-target="#{{ plot_id }}-pane" type="button" role="tab"
            aria-controls="{{ plot_id }}-pane" aria-selected="{{ loop.last }}">{{ key }}</button>
    </li>
    {% endfor %}
</ul>
<div class="tab-content mb-3">
    {% for plot in tab_dict.values() %}
    {% set plot_id = id ~ "-" ~ loop.index %}
    <div class="tab-pane fade {% if (last and loop.last) or (not last and loop.first) %} show active {% endif %}"
        id="{{ plot_id }}-pane" role="tabpanel" aria-labelledby="{{ plot_id }}-tab" tabindex="0">
        {{ vega_direct(plot) }}
    </div>
    {% endfor %}
</div>
{% endmacro %}

{% macro parametric_plot(spec, plot_groups, outer_loop_index) %}
{% if spec.group_by %}
<ul class="nav nav-pills mb-3" id="myTab_{{ outer_loop_index }}" role="tablist">
    {% for key, plot in plot_groups.items() %}
    {% set plot_id = "custom_plot_" ~ outer_loop_index ~ "_" ~ loop.index %}
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if loop.last %} active {% endif %}" id="{{ plot_id }}-tab" data-bs-toggle="tab"
            data-bs-target="#{{ plot_id }}-pane" type="button" role="tab" aria-controls="{{ plot_id }}-pane"
            aria-selected="{{ loop.last }}">{{ key }}</button>
    </li>
    {% endfor %}
</ul>
<div class="tab-content mb-3" id="myTabContent_{{ outer_loop_index }}">
    {% for key, plot in plot_groups.items() %}
    {% set plot_id = "custom_plot_" ~ outer_loop_index ~ "_" ~ loop.index %}
    <div class="tab-pane fade {% if loop.last %} show active {% endif %}" id="{{ plot_id }}-pane" role="tabpanel"
        aria-labelledby="{{ plot_id }}-tab" tabindex="0">
        {{ vega_direct(plot) }}
    </div>
    {% endfor %}
</div>
{% else %}
<div class="row mb-3">
    <div class="col">
        {{ vega_direct(plot_groups[""]) }}
    </div>
</div>
{% endif %}
{% endmacro %}