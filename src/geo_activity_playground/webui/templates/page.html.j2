<!DOCTYPE html>
<html lang="en">

{% from "plot-macros.html.j2" import vega, vega_direct, fetched_vega, activity_tag, tabbed_vega %}
{% from "plot-macros.html.j2" import map_script, fetched_map with context %}
{% from "nav-macros.html.j2" import nav_active, nav_group_active with context %}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{ _('Geo Activity Playground') }}</title>

    <script>
        window.gapHillshade = {
            opacity: {{ hillshade_opacity | tojson }},
            blendMode: {{ hillshade_blend_mode | tojson }}
        };
    </script>

    <link rel="stylesheet" href="/static/dist/app.css">
    <script type="module" src="/static/dist/app.js"></script>

    <!-- Favicon. -->
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png">
    <link rel="manifest" href="/static/favicons/site.webmanifest">
    <link rel="shortcut icon" href="/static/favicons/favicon.ico">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-config" content="/static/favicons/browserconfig.xml">
    <meta name="theme-color" content="#ffffff">
</head>

<body>
    {# Navigation structure for the main menu. A group with `entries` renders as a
       dropdown, a group with an `endpoint` as a plain link. #}
    {% set explorer = namespace(tiles=[], squares=[]) %}
    {% for zoom in explorer_zoom_levels %}
    {% set explorer.tiles = explorer.tiles + [{
        "endpoint": "explorer.server_side",
        "args": {"zoom": zoom},
        "label": explorer_zoom_level_label(zoom),
    }] %}
    {% set explorer.squares = explorer.squares + [{
        "endpoint": "square_planner.landing",
        "args": {"zoom": zoom},
        "match": ["square_planner.index"],
        "label": _('Square Planner (Zoom %(zoom)d)', zoom=zoom),
    }] %}
    {% endfor %}

    {% set main_nav = [
        {
            "label": _('Activities'),
            "needs_activities": true,
            "entries": [
                {"endpoint": "search.index", "label": _('Overview & Search')},
                {"endpoint": "search.map_view", "label": _('Search as Map')},
                {"endpoint": "calendar.index", "label": _('Calendar'),
                 "match": ["calendar.month", "calendar.day"]},
                {"endpoint": "bubble_chart.index", "label": _('Bubble Chart')},
                {"endpoint": "segments.index", "label": _('Segments'), "match": ["segments."]},
            ]
        },
        {
            "label": _('Explorer'),
            "needs_activities": true,
            "entries": explorer.tiles + [{"divider": true}] + explorer.squares + [
                {"divider": true},
                {"endpoint": "explorer_video.video", "label": _('Video Export')},
            ]
        },
        {
            "label": _('Maps'),
            "entries": [
                {"endpoint": "heatmap.index", "label": _('Heatmap'), "needs_activities": true},
                {"endpoint": "streets.index", "label": _('Streets'), "needs_activities": true},
                {"endpoint": "photo.map", "label": _('Photo Map'), "needs_photos": true},
            ]
        },
        {
            "label": _('Statistics'),
            "needs_activities": true,
            "entries": [
                {"endpoint": "summary.index", "label": _('Summary Statistics')},
                {"endpoint": "calendar.wrap_latest", "label": _('Year & Month Wrap'),
                 "match": ["calendar.wrap_year", "calendar.wrap_month"]},
                {"endpoint": "hall_of_fame.index", "label": _('Hall of Fame')},
                {"endpoint": "eddington.distance", "label": _('Eddington Number')},
                {"endpoint": "eddington.elevation_gain", "label": _('Elevation Eddington Number')},
            ]
        },
        {
            "label": _('Gear'),
            "needs_activities": true,
            "entries": [
                {"endpoint": "equipment.index", "label": _('Equipment'), "match": ["equipment."]},
                {"endpoint": "maintenance.index", "label": _('Maintenance'), "match": ["maintenance."]},
            ]
        },
        {
            "label": _('Data'),
            "entries": [
                {"endpoint": "upload.index", "label": _('Upload Activities')},
                {"endpoint": "photo.new", "label": _('Upload Photos')},
                {"endpoint": "upload.reload", "label": _('Scan New Activities')},
                {"divider": true},
                {"endpoint": "export.index", "label": _('Data Export')},
            ]
        },
        {
            "label": _('Settings'),
            "endpoint": "settings.index",
            "match": ["settings.", "authentication.change_password", "plot_builder."],
        },
    ] %}

    {# Yields "visible" unless the entry depends on data that does not exist yet. #}
    {% macro nav_visible(item) %}
        {%- if item.get('needs_activities') and not num_activities -%}
        {%- elif item.get('needs_photos') and not photo_count -%}
        {%- else -%}visible{%- endif -%}
    {% endmacro %}

    <div class="container">
        <nav class="navbar navbar-expand-lg bg-body-secondary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ url_for('index') }}">{{ _('Geo Activity Playground') }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="{{ _('Toggle navigation') }}">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {% for group in main_nav %}
                        {% if nav_visible(group) | trim %}

                        {# A group is only worth a dropdown once more than one of its
                           entries is actually available. #}
                        {% set shown = namespace(entries=[], links=[]) %}
                        {% for item in group.get('entries') or [] %}
                        {% if nav_visible(item) | trim %}
                        {% set shown.entries = shown.entries + [item] %}
                        {% if not item.get('divider') %}
                        {% set shown.links = shown.links + [item] %}
                        {% endif %}
                        {% endif %}
                        {% endfor %}

                        {% if shown.links | length > 1 %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle {{ nav_group_active(group) | trim }}" href="#"
                                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ group.label }}
                            </a>
                            <ul class="dropdown-menu">
                                {% for item in shown.entries %}
                                {% if item.get('divider') %}
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                {% else %}
                                <li><a class="dropdown-item {{ nav_active(item) | trim }}"
                                        href="{{ url_for(item.endpoint, **(item.get('args') or {})) }}" {% if
                                        nav_active(item) | trim %}aria-current="page" {% endif %}>{{ item.label }}</a>
                                </li>
                                {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                        {% else %}
                        {% set link = shown.links[0] if shown.links else (group if not group.get('entries') else none) %}
                        {% if link %}
                        <li class="nav-item">
                            <a class="nav-link {{ nav_active(link) | trim }}"
                                href="{{ url_for(link.endpoint, **(link.get('args') or {})) }}" {% if nav_active(link) |
                                trim %}aria-current="page" {% endif %}>{{ link.label }}</a>
                        </li>
                        {% endif %}
                        {% endif %}

                        {% endif %}
                        {% endfor %}
                    </ul>

                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item dropdown">
                            <button
                                class="btn btn-link nav-link py-2 px-0 px-lg-2 dropdown-toggle d-flex align-items-center"
                                id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown"
                                data-bs-display="static" aria-label="{{ _('Toggle theme') }}">
                                <span id="bd-theme-text">{{ _('Theme') }}</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme-text">
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center"
                                        data-bs-theme-value="light" aria-pressed="false">
                                        ☀️ {{ _('Light') }}
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center active"
                                        data-bs-theme-value="dark" aria-pressed="true">
                                        🌙 {{ _('Dark') }}
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center"
                                        data-bs-theme-value="auto" aria-pressed="false">
                                        ⚙️ {{ _('Auto') }}
                                    </button>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <form action="{{ url_for('shutdown.shutdown') }}" method="POST" class="m-0"
                                onsubmit="return confirm('{{ _('Are you sure you want to shut down the server? This will terminate the application.') }}');">
                                <button type="submit" class="btn btn-link nav-link py-2 px-0 px-lg-2 text-danger"
                                    title="{{ _('Shutdown Server') }}" aria-label="{{ _('Shutdown Server') }}">⏻</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {% if version %}
        <div id="version-notice" class="alert alert-info alert-dismissible fade show small py-2 d-none"
            role="alert" data-version="{{ version }}"
            data-message="{{ _('You previously used version %(old)s and are now on version %(new)s.', old='{old}', new=version) }}">
            <span class="version-notice-text"></span>
            <a href="https://martin-ueding.github.io/geo-activity-playground/changelog/" target="_blank"
                class="alert-link">{{ _('See the changelog.') }}</a>
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="{{ _('Close') }}"></button>
        </div>
        {% endif %}

        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        {% for category, message in messages %}
        <div class="alert alert-{{ category }}" role="alert">
            {{ message }}
        </div>
        {% endfor %}
        {% endif %}
        {% endwith %}

        {% block container %}
        {% endblock %}

        <div class="row border-top py-3 my-4">
            <ul class="nav col-4">
                <li class="nav-item"><a
                        href="https://github.com/martin-ueding/geo-activity-playground/blob/main/docs/changelog.md"
                        class="nav-link px-2 text-muted" target="_blank">{{ _('Version') }} {{ version }}</a></li>

                <li class="nav-item"><span class="nav-link px-2 text-muted">Python {{ python_version
                        }}</span></li>
            </ul>
            <ul class="nav col-8 justify-content-end">
                <li class="nav-item"><a href="https://github.com/martin-ueding/geo-activity-playground"
                        class="nav-link px-2 text-muted" target="_blank">GitHub</a></li>
                <li class="nav-item"><a href="https://martin-ueding.github.io/geo-activity-playground/"
                        class="nav-link px-2 text-muted" target="_blank">{{ _('Documentation') }}</a></li>
                <li class="nav-item"><a href="https://bonn.social/tags/GeoActivityPlayground"
                        class="nav-link px-2 text-muted" target="_blank">Mastodon</a></li>
                <li class="nav-item"><a href="https://pypi.org/project/geo-activity-playground/"
                        class="nav-link px-2 text-muted" target="_blank">PyPI</a></li>
                <li class="nav-item"><a href="https://martin-ueding.de/" class="nav-link px-2 text-muted">Martin
                        Ueding</a></li>
            </ul>
        </div>
    </div>
</body>

</html>