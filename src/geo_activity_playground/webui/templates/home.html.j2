{% extends "page.html.j2" %}

{% block container %}
<div class="row mb-3">
</div>

{% if due_tasks %}
<div class="row mb-3">
    <div class="col">
        <div class="card border-danger">
            <div class="card-body">
                <h2 class="h4 card-title">{{ _('Due maintenance tasks') }}</h2>
                <ul class="list-unstyled mb-0">
                    {% for task in due_tasks %}
                    <li>
                        <a href="{{ url_for('equipment.show', id=task.equipment.id) }}">{{ task.equipment.name }}</a>
                        &middot; {{ task.title }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if latest_activities %}
<div class="row mb-3">
    <div class="col">
        <h2>{{ _('Last 30 days') }}</h2>
        {{ tabbed_vega(last_30_days_plot) }}
    </div>
</div>

{{ map_script() }}
<h2>{{ _('Latest activities') }}</h2>

{% for date, date_data in latest_activities.items() %}
<h3>{{ date }}</h3>
{% for activity_batch in date_data|batch(3) %}
<div class="row row-cols-1 row-cols-md-3 g-4 mb-3">
    {% for elem in activity_batch %}
    <div class="col">
        <div class="card border-primary">
            {{ fetched_map("map-" ~ elem.activity.id, url_for('activity.geojson_line', id=elem.activity.id)) }}
            <div class="card-body">
                <a href="{{ url_for('activity.show', id=elem.activity.id) }}">
                    <h5 class="card-title">{{ elem.activity.name }}</h5>
                </a>
                <p class="card-text">
                    {{ elem.activity.emoji_string }}
                </p>
                {% if elem.activity.start_local_tz %}
                <p class="card-text"><small class="text-body-secondary">{{ elem.activity.start_local_tz|dt }} {{
                        elem.activity.iana_timezone }}</small></p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endfor %}
{% endfor %}
{% else %}
<p>{{ _('You don\'t have activities yet. Either put some files into a directory') }} <tt>Activities</tt>, <a
        href="{{ url_for('upload.index') }}">{{ _('upload activities') }}</a> {{ _('or') }} <a
        href="{{ url_for('settings.strava') }}">{{ _('set up Strava API') }}</a>.</p>
{% endif %}

{% endblock %}