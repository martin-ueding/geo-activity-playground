msgid "Could not parse start time."
msgstr "Kon de starttijd niet lezen."

#: src/geo_activity_playground/features/activity/blueprint.py:436
#, python-format
msgid "Updated %(count)s activities."
msgstr "%(count)s activiteiten bijgewerkt."

#: src/geo_activity_playground/features/activity/blueprint.py:530
msgid "Activity has been re-enriched."
msgstr "Activiteit is opnieuw verrijkt."

#: src/geo_activity_playground/features/activity/blueprint.py:543
msgid ""
"This activity could not be re-imported because its source data is not "
"available."
msgstr ""
"Deze activiteit kon niet opnieuw worden geïmporteerd, omdat de "
"brongegevens niet beschikbaar zijn."

#: src/geo_activity_playground/features/activity/blueprint.py:551
msgid ""
"The activity has been read again from its source data. Your edits have "
"been kept."
msgstr ""
"De activiteit is opnieuw uit de brongegevens ingelezen. Je wijzigingen "
"zijn behouden."

#: src/geo_activity_playground/features/activity/blueprint.py:608
#, python-format
msgid "The activity and its source file %(path)s have been deleted."
msgstr "De activiteit en het bronbestand %(path)s zijn verwijderd."

#: src/geo_activity_playground/features/activity/blueprint.py:615
msgid ""
"The activity has been hidden. Its source data is left untouched, but it "
"will not be imported again. You can undo this from Settings → Excluded "
"Activities, or by uploading the file again."
msgstr ""
"De activiteit is verborgen. De brongegevens blijven ongemoeid, maar de "
"activiteit wordt niet opnieuw geïmporteerd. Je kunt dit ongedaan maken "
"via Instellingen → Uitgesloten activiteiten of door het bestand opnieuw "
"te uploaden."

