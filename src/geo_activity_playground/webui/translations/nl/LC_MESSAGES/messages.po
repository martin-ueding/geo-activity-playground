#: src/geo_activity_playground/webui/templates/settings/language.html.j2:10
msgid ""
"Choose your preferred language for the user interface. This setting will "
"override your browser's language preference."
msgstr ""
"Kies je voorkeurstaal voor de gebruikersinterface. Deze instelling "
"overschrijft de taalvoorkeur van je browser."

#: src/geo_activity_playground/webui/templates/settings/language.html.j2:14
