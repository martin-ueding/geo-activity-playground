{% extends "page.html.j2" %}

{% block container %}

<h1>{{ _('Explorer Tiles') }}</h1>

{% if not zoom_level_not_generated %}
<div class="mb-3">
    {% include "search_form.html.j2" %}
</div>
{% endif %}

{% if zoom_level_not_generated %}
<p>{{ _('You try to access explorer tiles for a level that hasn\'t been generated before. That is not a problem, we just don\'t generate all levels to save a bit of time. If you want to have it, just enable it!') }}</p>

<form method="post" action="{{ url_for('.enable_zoom_level', zoom=zoom_level_not_generated) }}" class="d-inline">
    <button type="submit" class="btn btn-primary">{{ _('Enable Zoom') }} {{ zoom_level_not_generated }}</button>
</form>

<p class="mt-3">{{ _('All enabled zoom levels can be managed in the <a href="%(url)s">Explorer Zoom Levels settings</a>.', url=url_for('settings.explorer_zoom_levels'))|safe }}</p>
{% else %}

<div class="row mb-3">
    <div class="col">
        {% set square_planner_url = url_for('square_planner.index', zoom=zoom, x=square_x, y=square_y, size=square_size) if square_x is not none and square_y is not none and square_size > 0 else url_for('square_planner.landing', zoom=zoom) %}
        <p>{{ _('You have %(num_tiles)s explored tiles. There are %(num_cluster_tiles)s cluster tiles in total. Your largest cluster consists of %(max_cluster_size)s tiles. Your largest square has size %(square_size)s².', num_tiles=num_tiles, num_cluster_tiles=num_cluster_tiles, max_cluster_size=max_cluster_size, square_size=square_size) }}</p>
        <p>{{ _('Open the <a href="%(url)s">Square Planner</a> to plan the next extension.', url=square_planner_url)|safe }}</p>
        <p>{{ _('Video export is available on the dedicated <a href="%(url)s">Explorer Video Export page</a>.', url=url_for('explorer_video.video', zoom=zoom))|safe }}</p>
    </div>
</div>

{% if bookmarks %}
<div class="btn-group mb-3" role="group" aria-label="Cluster bookmarks">
    <button type="button" class="btn btn-outline-primary" data-center-bbox='{{ center.bbox | safe }}'>Biggest ({{ max_cluster_size }})</button>
    {% for bookmark in bookmarks %}
    <button type="button" class="btn btn-outline-primary" data-center-bbox='{{ bookmark.bbox | safe }}'>{{ bookmark.name }} ({{ bookmark.size }})</button>
    {% endfor %}
</div>
{% endif %}

<div class="row mb-3">
    <div class="col">
        <button type="button" id="load-cluster-history" class="btn btn-outline-primary mb-2">Load Cluster History</button>
        <div id="cluster-history-controls" class="d-none">
            <label class="form-label" for="cluster-history-slider">{{ _('Cluster history cutoff') }}: <span
                    id="cluster-history-value">0</span> / <span id="cluster-history-max">0</span></label>
            <input
                class="form-range mb-2"
                type="range"
                min="0"
                max="0"
                step="1"
                value="0"
                id="cluster-history-slider"
            >
        </div>
        <p id="cluster-history-status" class="text-muted small mb-2"></p>
        <div id="explorer-map" class="mb-1" style="height: min(800px, calc(100vh - 300px));"></div>
        <p class="mb-2">{{ _('Download tiles in visible area:') }}</p>
        {% set download_groups = [
            (_('Explored'), 'explored', mkgmap_available),
            (_('Missing'), 'missing', mkgmap_available),
            (_('Inaccessible'), 'inaccessible', false),
        ] %}
        <div class="btn-toolbar gap-2 mb-3" role="toolbar" aria-label="{{ _('Tile downloads') }}">
            {% for label, kind, garmin in download_groups %}
            <div class="input-group input-group-sm w-auto">
                <span class="input-group-text">{{ label }}</span>
                <a href="#" class="btn btn-outline-primary" data-download-suffix="{{ kind }}.geojson">{{ _('GeoJSON') }}</a>
                <a href="#" class="btn btn-outline-primary" data-download-suffix="{{ kind }}.gpx">{{ _('GPX') }}</a>
                <a href="#" class="btn btn-outline-primary" data-download-suffix="{{ kind }}.kml">{{ _('KML') }}</a>
                {% if garmin %}
                <a href="#" class="btn btn-outline-primary" data-download-suffix="{{ kind }}.img">{{ _('Garmin map') }}</a>
                {% endif %}
                {% if kind == 'explored' %}
                <a href="{{ url_for('.download_squadrats') }}" class="btn btn-outline-primary"
                    title="{{ _('All explored tiles at zoom 14 and 17 as a Squadrats-compatible KML for the Explorer Tile Helper app, independent of the visible area.') }}">{{ _('Squadrats KML') }}</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <script type="module">
            import { initExplorerMap } from '/static/dist/server-side-explorer.js';
            initExplorerMap({
                centerLatitude: {{ center.latitude }},
                centerLongitude: {{ center.longitude }},
                zoom: {{ zoom }},
                zoomLevels: {{ explorer_zoom_levels | tojson }},
                attribution: '{{ map_tile_attribution|safe }}',
                {% if center.bbox is not none %}
                bbox: {{ center.bbox | safe }},
                {% endif %}
                searchQuery: '{{ base_query_str|safe }}' || null
            });
        </script>
    </div>
</div>

{% if bookmarks %}
<h2 class="mb-3">{{ _('Bookmarked cluster sizes') }}</h2>

<table class="table mb-3">
    <thead>
        <tr>
            <th>{{ _('Name') }}</th>
            <th>{{ _('Tiles') }}</th>
            <th>{{ _('Relative to maximum') }}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>{{ _('Max Cluster') }}</td>
            <td>{{ max_cluster_size }}</td>
            <td></td>
            <td></td>
        </tr>
        {% for bookmark in bookmarks %}
        <tr>
            <td>{{ bookmark.name }}</td>
            <td>{{ bookmark.size }}</td>
            <td>{{ '%.1f'|format(bookmark.size / max_cluster_size * 100) }} %</td>
            <td>
                <form method="post" action="{{ url_for('settings.cluster_bookmark_delete', id=bookmark.id) }}" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm"
                        onclick="if(!confirm('{{ _('Are you sure to delete this?') }}')){event.preventDefault()}">{{ _('Delete') }}</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

{% endif %}

<h2 class="mb-3">{{ _('Tile history') }}</h2>

{% if search_active %}
<p class="text-body-secondary">{{ _('The tile history is recorded for your configured explorer activities and does not follow the filter above, so these plots are hidden while a filter is active.') }}</p>
{% else %}
{% if history_stale %}
<p class="text-body-secondary">{{ _('The tile history has changed since these plots were last computed. They are being brought up to date, which can take a moment.') }}</p>
{% endif %}

<div class="row mb-3">
    <div class="col-md-4">
        {{ fetched_vega(url_for('.evolution_plot', zoom=zoom, plot='tiles')) }}
    </div>
    <div class="col-md-4">
        {{ fetched_vega(url_for('.evolution_plot', zoom=zoom, plot='cluster')) }}
    </div>
    <div class="col-md-4">
        {{ fetched_vega(url_for('.evolution_plot', zoom=zoom, plot='square')) }}
    </div>
</div>
{% endif %}

<h2 class="mb-3">{{ _('Tile coloring') }}</h2>
<p><a href="{{ url_for('settings.tile_rendering') }}">{{ _('Modify tile rendering') }}</a>.</p>

<h2 class="mb-3">{{ _('Tile URLs') }}</h2>

<p>{{ _('You can use the overlay tiles with other services like <a href="https://bikerouter.de/" target="_blank">BikeRouter</a>.')|safe }} {{ _('See <a href="https://martin-ueding.github.io/geo-activity-playground/using-maps-as-overlays/" target="_blank">the documentation for this feature</a>.')|safe }} {{ _('For your server, use the following URLs:') }}</p>

<code><pre class="tile-urls">/tile/grayscale/{z}/{x}/{y}.png
/tile/pastel/{z}/{x}/{y}.png
/tile/color/{z}/{x}/{y}.png
/tile/inverse_grayscale/{z}/{x}/{y}.png</pre></code>

<p>{{ _('For the explorer tiles, you can use these:') }}</p>

<code><pre class="tile-urls">/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=colorful_cluster
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=max_cluster
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=first
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=last
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=visits
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=missing
/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=latest_new

/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=colorful_cluster
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=max_cluster
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=first
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=last
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=visits
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=missing
/explorer/17/tile/{z}/{x}/{y}.png?color_strategy=latest_new</pre></code>

<p>{{ _('The <code>latest_new</code> strategy outlines the tiles that one activity discovered and the tiles that joined a cluster with it. It uses the most recent activity that found a tile at the given zoom level. Append <code>&amp;activity_id=…</code> to pick a specific activity instead:')|safe }}</p>

<code><pre class="tile-urls">/explorer/14/tile/{z}/{x}/{y}.png?color_strategy=latest_new&amp;activity_id=123</pre></code>

<p>{{ _('The track of the most recent activity that discovered a tile at the given zoom level is available as a solid-colored line in its own layer (configurable under Settings → Tile Rendering). Append <code>?activity_id=…</code> to pick a specific activity instead:')|safe }}</p>

<code><pre class="tile-urls">/explorer/14/latest-new-tiles-activity/{z}/{x}/{y}.png
/explorer/17/latest-new-tiles-activity/{z}/{x}/{y}.png</pre></code>

<p>{{ _('The tiles that you have marked as inaccessible form their own layer that you can combine with any of the above:') }}</p>

<code><pre class="tile-urls">/explorer/14/inaccessible-tile/{z}/{x}/{y}.png
/explorer/17/inaccessible-tile/{z}/{x}/{y}.png</pre></code>

<p>{{ _('And for the heatmap, you can use this:') }}</p>

<code><pre class="tile-urls">/heatmap/tile/{z}/{x}/{y}.png</pre></code>

<h2 class="mb-3">{{ _('Style JSON for MapLibre GL clients') }}</h2>

<p>{{ _('Applications that consume a MapLibre GL style document rather than a plain tile URL (for example <a href="https://wanderer.to/" target="_blank">Wanderer</a>) can use this endpoint, which returns the explorer tiles injected as a raster source and layer:')|safe }}</p>

<code><pre class="tile-urls">/explorer/{{ zoom }}/style.json?color_strategy=colorful_cluster</pre></code>

<p>{{ _('If <code>map_style_url</code> is set in <code>config.json</code>, that style is fetched and extended with the explorer tiles source and layer. Otherwise a minimal raster style is generated from the configured map tile URL. Both this endpoint and the explorer tile endpoints send an <code>Access-Control-Allow-Origin: *</code> header, so external browser-based map applications can fetch them directly.')|safe }}</p>

<p>{{ _('To combine several explorer layers into a single style document (for example the visited tiles and the inaccessible tiles at multiple zoom levels), use the combined endpoint instead. Without a <code>layers</code> parameter it includes the <code>colorful_cluster</code> and <code>inaccessible</code> layers for every configured explorer zoom level:')|safe }}</p>

<code><pre class="tile-urls">/explorer/style.json</pre></code>

<p>{{ _('Pass <code>layers</code> as a comma-separated list of <code>zoom:kind</code> entries, where <code>kind</code> is either a color strategy, the literal <code>inaccessible</code> or the literal <code>latest_new_activity</code>, to control exactly which layers are combined and in which order:')|safe }}</p>

<code><pre class="tile-urls">/explorer/style.json?layers=14:colorful_cluster,14:inaccessible,17:colorful_cluster,17:inaccessible</pre></code>

<script>
// Prepend the current origin (protocol + host) to tile URLs
// This ensures correct https:// when behind a reverse proxy
document.querySelectorAll('pre.tile-urls').forEach(pre => {
    pre.textContent = pre.textContent.split('\n')
        .map(line => line.trim() ? window.location.origin + line : line)
        .join('\n');
});
</script>

{% endif %}
{% endblock %}
