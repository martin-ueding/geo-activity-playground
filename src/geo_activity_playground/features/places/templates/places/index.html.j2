{% extends "page.html.j2" %}

{% block container %}
<h1 class="mb-3">{{ _('Places') }}</h1>

<p>
    {{ _('Places are named locations. Starts, ends and stops of at least three minutes within 50 m of a place count as visits. Two consecutive visits within an activity form a leg.') }}
    <a href="{{ url_for('.edit') }}">{{ _('Create and edit places') }}</a>
</p>

<div class="mb-3">
    {% include "search_form.html.j2" %}
</div>

{% if places %}
<h2 class="mb-3">{{ _('Map') }}</h2>

{{ map_script() }}
<div id="map-places" class="mb-3" style="height: 600px; width: 100%;"></div>
<script type="module">
    const places = {{ map_places | tojson }};
    const edges = {{ map_edges | tojson }};
    const roundTripsLabel = {{ _('round trips') | tojson }};
    const color = "#1f77b4";

    function text(content) {
        const span = document.createElement("span");
        span.textContent = content;
        return span;
    }

    const map = add_map("map-places", null);
    const maxCount = Math.max(1, ...edges.map(edge => edge.count));
    for (const edge of edges) {
        const origin = places[edge.origin];
        const destination = places[edge.destination];
        const a = map.project([origin.latitude, origin.longitude], 0);
        const b = map.project([destination.latitude, destination.longitude], 0);
        const direction = b.subtract(a);
        // Bending to the right of the direction of travel separates A → B from B → A.
        const control = a.add(b).divideBy(2).add(L.point(-direction.y, direction.x).multiplyBy(0.15));
        const curve = [];
        for (let i = 0; i <= 32; i++) {
            const t = i / 32;
            curve.push(map.unproject(
                a.multiplyBy((1 - t) ** 2).add(control.multiplyBy(2 * (1 - t) * t)).add(b.multiplyBy(t ** 2)), 0));
        }
        const weight = 1 + 9 * edge.count / maxCount;
        const tooltip = text(`${origin.name} → ${destination.name}: ${edge.count}`);
        L.polyline(curve, { color: color, weight: weight, opacity: 0.7 }).bindTooltip(tooltip).addTo(map);

        const size = 10 + 2 * weight;
        const angle = Math.atan2(direction.y, direction.x) * 180 / Math.PI;
        L.marker(map.unproject(a.add(control.multiplyBy(2)).add(b).divideBy(4), 0), {
            interactive: false,
            icon: L.divIcon({
                className: "",
                iconSize: [size, size],
                iconAnchor: [size / 2, size / 2],
                html: `<svg width="${size}" height="${size}" viewBox="0 0 10 10" style="transform: rotate(${angle}deg)">
                    <path d="M 1 1 L 9 5 L 1 9 Z" fill="${color}" stroke="white" stroke-width="0.8" /></svg>`,
            }),
        }).addTo(map);
    }

    const markers = Object.values(places).map(place => {
        const label = place.round_trips ? `${place.name} (${place.round_trips} ${roundTripsLabel})` : place.name;
        return L.circleMarker([place.latitude, place.longitude], {
            radius: 7, color: "#d62728", fillOpacity: 0.8,
        }).bindTooltip(text(label), { permanent: true, direction: "right" }).addTo(map);
    });
    map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [50, 50], maxZoom: 15 });
</script>
{% endif %}

<h2 class="mb-3">{{ _('Origin–destination matrix') }}</h2>

{% if matrix_keys %}
<p>{{ _('Number of legs from the place in the row to the place in the column.') }}</p>
<div class="table-responsive mb-3">
    <table class="table table-sm table-bordered text-end">
        <thead>
            <tr>
                <th class="text-start">{{ _('From') }} \ {{ _('To') }}</th>
                {% for destination in matrix_keys %}
                <th>{{ names.get(destination, _('Unknown')) }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for origin in matrix_keys %}
            <tr>
                <th class="text-start">{{ names.get(origin, _('Unknown')) }}</th>
                {% for destination in matrix_keys %}
                <td>{{ legs[(origin, destination)] or '' }}</td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<p>{{ _('No legs found.') }}</p>
{% endif %}

{% if places %}
<h2 class="mb-3">{{ _('Activities by place') }}</h2>
<div class="table-responsive mb-3">
    <table class="table table-sm">
        <thead>
            <tr>
                <th>{{ _('Place') }}</th>
                <th>{{ _('Activities') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for place in places %}
            <tr>
                <td>{{ place.name }}</td>
                <td>
                    <a href="{{ url_for('search.index', start_place=place.id) }}">{{ _('Starting here') }}</a> ·
                    <a href="{{ url_for('search.index', end_place=place.id) }}">{{ _('Ending here') }}</a> ·
                    <a href="{{ url_for('search.index', stop_place=place.id) }}">{{ _('Visiting') }}</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
