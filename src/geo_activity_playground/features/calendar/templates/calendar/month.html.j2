{% extends "page.html.j2" %}

{% block container %}
<div class="row mb-1">
    <div class="col">
        <h1>{{ _('Calendar') }} {{ year }}-{{ "{0:02d}".format(month) }}</h1>
    </div>
</div>

<div class="row mb-1">
    <div class="col">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ _('Week') }}</th>
                        <th>{{ _('Monday') }}</th>
                        <th>{{ _('Tuesday') }}</th>
                        <th>{{ _('Wednesday') }}</th>
                        <th>{{ _('Thursday') }}</th>
                        <th>{{ _('Friday') }}</th>
                        <th>{{ _('Saturday') }}</th>
                        <th>{{ _('Sunday') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for week, week_data in weeks.items() %}
                    <tr>
                        <td>{{ week }}</td>
                        {% for day in range(1, 8) %}
                        {% set day_activities = week_data.get(day) %}
                        {% set day_number = day_of_month[week].get(day) %}
                        <td>
                            {% if day_activities %}
                            <a href="{{ url_for('calendar.day', year=year, month=month, day=day_number) }}"><b>{{
                                    day_number }}.</b></a>
                            {% elif day_number %}
                            <b>{{ day_number }}.</b>
                            {% endif %}

                            {% if day_activities %}
                            <ul>
                                {% for activity in day_activities %}
                                <li><a href="{{ url_for('activity.show', id=activity.id) }}">{{ activity.name }}</a></li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>


{% endblock %}